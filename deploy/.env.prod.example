# Copy to deploy/.env.prod and fill in. Never commit the real file.

# Postgres password for the bundled postgres container (any long random string).
POSTGRES_PASSWORD=change-me

# --- AWS S3 (real) ---
# Leave S3_ENDPOINT_URL empty to use real AWS S3.
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
AWS_REGION=ap-south-1
S3_BUCKET_ORIGINALS=yourname-photos-originals
S3_BUCKET_THUMBS=yourname-photos-thumbs
# On EC2 with an instance role, delete these two lines; boto3 picks up the role automatically.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# --- Search / model ---
CLIP_MODEL=ViT-B/32
SEARCH_IMG_WEIGHT=0.7

# --- API ---
MAX_UPLOAD_MB=25
# Browser origin of the dashboard. Same origin as the API through nginx, so this mostly matters
# if you serve the frontend from a different domain.
CORS_ORIGINS=https://photos.example.com

# Host port for the web container.
WEB_PORT=80
